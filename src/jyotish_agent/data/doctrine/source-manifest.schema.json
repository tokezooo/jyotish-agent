{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jyotish-agent.local/schemas/doctrine/source-manifest-1.0.json",
  "title": "Jyotish private source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "title", "author_or_commentator", "edition", "year",
          "languages", "domain", "school_role", "license_class", "local_file",
          "sha256", "page_offset", "scan_quality", "ocr_required", "ocr_status"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "author_or_commentator": {"type": "string", "minLength": 1},
          "translator_editor": {"type": ["string", "null"]},
          "edition": {"type": "string", "minLength": 1},
          "publisher": {"type": ["string", "null"]},
          "year": {"type": "integer", "minimum": 1, "maximum": 3000},
          "isbn": {"type": ["string", "null"]},
          "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "domain": {"enum": ["jaimini", "prashna", "muhurta"]},
          "school_role": {"enum": ["root_text", "baseline", "commentary", "overlay", "worked_examples"]},
          "license_class": {"enum": ["public_domain", "permissive", "licensed_local", "copyrighted_local"]},
          "local_file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "page_offset": {"type": "integer", "minimum": -10000, "maximum": 10000},
          "scan_quality": {"enum": ["born_digital", "good", "fair", "poor"]},
          "ocr_required": {"type": "boolean"},
          "ocr_status": {"enum": ["not_required", "required", "completed", "reviewed"]}
        }
      }
    }
  }
}
